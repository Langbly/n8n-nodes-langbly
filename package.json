{
  "name": "n8n-nodes-langbly",
  "version": "1.0.10",
  "description": "n8n community node for Langbly. Context-aware translation, Google Translate v2 compatible, 75% lower published usage rate.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "translation",
    "langbly",
    "i18n",
    "localization",
    "machine-translation"
  ],
  "license": "MIT",
  "author": {
    "name": "Langbly",
    "email": "hello@langbly.com"
  },
  "homepage": "https://langbly.com/?utm_source=npm&utm_medium=plugin&utm_campaign=n8n-community-node&utm_content=package-metadata",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Langbly/n8n-nodes-langbly.git"
  },
  "main": "dist/nodes/Langbly/Langbly.node.js",
  "scripts": {
    "build": "tsc && cp nodes/Langbly/langbly.svg nodes/Langbly/langbly.dark.svg dist/nodes/Langbly/ && cp nodes/Langbly/Langbly.node.json dist/nodes/Langbly/ && cp credentials/langbly.svg dist/credentials/",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Langbly/Langbly.node.js"
    ],
    "credentials": [
      "dist/credentials/LangblyApi.credentials.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "n8n-workflow": "^2.13.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
